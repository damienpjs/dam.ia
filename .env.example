# ──────────────────────────────────────────
# LLM Provider Configuration
# ──────────────────────────────────────────
# Provider à utiliser : "gemini" | "groq" | "mock"
# Si non défini, auto-détecte selon les clés API présentes et construit une
# chaîne de fallback Gemini → Groq : quand le quota de Gemini est atteint, les
# requêtes basculent automatiquement sur Groq (quota gratuit indépendant).
# Fallback sur "mock" si aucune clé n'est trouvée.
LLM_PROVIDER=

# Clé API Google Gemini (provider primaire)
# Obtenir : https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Clé API Groq (provider de secours)
# Obtenir : https://console.groq.com/keys
GROQ_API_KEY=

# ──────────────────────────────────────────
# Database (Neon PostgreSQL)
# ──────────────────────────────────────────
# Connection string Neon PostgreSQL
# Obtenir : https://console.neon.tech → projet → Connection Details
DATABASE_URL=

# ──────────────────────────────────────────
# Qdrant (Vector Database)
# ──────────────────────────────────────────
# URL de l'instance Qdrant
# Local (sous docker par exemple) : http://localhost:6333
# Cloud : https://xxx.cloud.qdrant.io
QDRANT_URL=

# Clé API Qdrant (optionnel en local, requis pour Qdrant Cloud)
QDRANT_API_KEY=

# ──────────────────────────────────────────
# GitHub (indexation RAG)
# ──────────────────────────────────────────
# Token d'accès personnel utilisé par `npm run rag:index` pour indexer les
# profils déclarés dans content/github.json.
# Optionnel : les données publiques sont lisibles sans token, le token ne fait
# que relever la limite de 60 à 5000 requêtes/heure.
# Obtenir : https://github.com/settings/tokens → Fine-grained token (lecture publique seule)
GITHUB_TOKEN=

# ──────────────────────────────────────────
# Rate limiting (Upstash Redis) — anti-spam
# ──────────────────────────────────────────
# Active le rate limiting par IP sur /api/chat et /api/feedback (proxy.ts).
# Optionnel : si absent, le rate limiting est désactivé (dégradation gracieuse).
# Obtenir : https://console.upstash.com → Redis → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ──────────────────────────────────────────
# CORS — contrôle d'origine des routes d'écriture
# ──────────────────────────────────────────
# Origines autorisées en plus du same-origin (liste séparée par des virgules).
# Optionnel : par défaut seule l'origine du site (same-origin) est acceptée.
# Exemple : https://preview.damienpasulj.com,https://partenaire.com
ALLOWED_ORIGINS=
