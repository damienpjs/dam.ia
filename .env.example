# ──────────────────────────────────────────
# LLM Provider Configuration
# ──────────────────────────────────────────
# Provider à utiliser : "gemini" | "mock"
# Si non défini, auto-détecte selon les clés API présentes.
# Fallback sur "mock" si aucune clé n'est trouvée.
LLM_PROVIDER=gemini

# Clé API Google Gemini
# Obtenir : https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ──────────────────────────────────────────
# Database (Neon PostgreSQL)
# ──────────────────────────────────────────
# Connection string Neon PostgreSQL
# Obtenir : https://console.neon.tech → projet → Connection Details
DATABASE_URL=

# ──────────────────────────────────────────
# Qdrant (Vector Database)
# ──────────────────────────────────────────
# URL de l'instance Qdrant
# Local (sous docker par exemple) : http://localhost:6333
# Cloud : https://xxx.cloud.qdrant.io
QDRANT_URL=

# Clé API Qdrant (optionnel en local, requis pour Qdrant Cloud)
QDRANT_API_KEY=
